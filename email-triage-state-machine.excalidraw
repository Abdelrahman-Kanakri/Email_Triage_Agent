      "isDeleted": false,
      "boundElements": [],
      "updated": 1784374349718,
      "link": null,
      "locked": false,
      "text": "> Reject + reason → drafting (new draft from that reason) →\nback to awaiting_approval.",
      "fontSize": 18.11390235659201,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "> Reject + reason → drafting (new draft from that reason) → back to awaiting_approval.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
