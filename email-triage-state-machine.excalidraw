      "type": "text",
      "x": 1620.4788333528625,
      "y": 63.62812575954575,
      "width": 686.4329833984375,
      "height": 47.278451371565055,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
