    {
      "id": "step2ToolsBodyTextA1",
      "type": "text",
      "x": 910.7696126177957,
      "y": 1427.2407676034973,
      "width": 1195.9998168945312,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
