      "versionNonce": 1120492892,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785669725923,
      "link": null,
      "locked": false,
      "text": "> No match → escalate to LLM classifier (not a clear pass — heuristic\ncan't prove \"clean\").",
      "fontSize": 18.91138054862602,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "> No match → escalate to LLM classifier (not a clear pass — heuristic can't prove \"clean\").",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "bXwTFDSZkpw84nm2XeJGb",
      "type": "text",
      "x": 1622.6002739270045,
      "y": 174.63945198611364,
      "width": 701.382285724498,
      "height": 70.91767705734759,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
