    {
      "id": "step3GuardrailsBodyTextA1",
      "type": "text",
      "x": -41.403644680664,
      "y": 2598.2359189105337,
      "width": 1196,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
