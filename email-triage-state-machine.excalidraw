      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786435061937,
      "link": null,
      "locked": false,
      "text": "10- HITL: interrupt() at awaiting_approval shows email + draft.\nApprove → send tool. Reject + reason → AI redrafts from scratch.\nEdit → human's text used verbatim, no AI, loops until approved.",
      "fontSize": 18.69816572773072,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "10- HITL: interrupt() at awaiting_approval shows email + draft. Approve → send tool. Reject + reason → AI redrafts from scratch. Edit → human's text used verbatim, no AI, loops until approved.",
      "autoResize": false,
      "lineHeight": 1.25,
      "version": 56,
