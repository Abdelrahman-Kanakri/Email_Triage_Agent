      "updated": 1784446670300,
      "link": null,
      "locked": false,
      "text": "9- Tool permission matrix: fetch_mail, send, authenticate are real\ntools. Heuristic (regex) + classifier are not — plain code / a\nseparate tool-less LLM call. Drafting = structured output, not a tool.",
      "fontSize": 18.69816572773072,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "9- Tool permission matrix: fetch_mail, send, authenticate are real tools. Heuristic (regex) + classifier are not — plain code / a separate tool-less LLM call. Drafting = structured output, not a tool.",
      "autoResize": false,
      "lineHeight": 1.25,
      "version": 54,
      "versionNonce": 495206542,
      "index": "b01",
      "isDeleted": false,
      "seed": 1
    },
    {
      "id": "hItL0aB3cDe5FgH8IjKlM",
      "type": "text",
      "x": 1610.999982561384,
      "y": 831.3,
      "width": 780,
      "height": 70.12,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1784446671509,
      "link": null,
      "locked": false,
      "text": "10- HITL: interrupt() at awaiting_approval shows email + draft.\nApprove → send tool. Reject + reason → AI redrafts from scratch.\nEdit → human's text used verbatim, no AI, loops until approved.",
      "fontSize": 18.69816572773072,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "10- HITL: interrupt() at awaiting_approval shows email + draft. Approve → send tool. Reject + reason → AI redrafts from scratch. Edit → human's text used verbatim, no AI, loops until approved.",
      "autoResize": false,
      "lineHeight": 1.25,
      "version": 34,
      "versionNonce": 1354450642,
      "index": "b02",
      "isDeleted": false,
      "seed": 1
    },
