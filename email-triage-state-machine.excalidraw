      "updated": 1786435060282,
      "link": null,
      "locked": false,
      "text": "9- Tool permission matrix: fetch_mail, send, authenticate are real tools.\nHeuristic (regex) + classifier are not — plain code / a separate tool-less\nLLM call. Drafting = structured output, not a tool.",
      "fontSize": 18.69816572773072,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "9- Tool permission matrix: fetch_mail, send, authenticate are real tools. Heuristic (regex) + classifier are not — plain code / a separate tool-less LLM call. Drafting = structured output, not a tool.",
      "autoResize": false,
      "lineHeight": 1.25,
      "version": 87,
      "versionNonce": 875582180,
      "index": "b01",
      "isDeleted": false,
      "seed": 1,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "hItL0aB3cDe5FgH8IjKlM",
      "type": "text",
      "x": 1623.6868763657394,
      "y": 853.5020641576218,
      "width": 780,
      "height": 70.12,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
