# Copy to .env and fill in. Never commit .env.

# ── OpenAI (required) ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MINI_MODEL=gpt-4.1-mini
OPENAI_REGURAL_MODEL=gpt-4.1

# ── LangSmith tracing (required keys; set TRACING=false to disable) ─
# Must be lowercase "true" -- LangSmith compares the exact string.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=email-triage-agent

# ── Data ───────────────────────────────────────────────────────────
EMAILS_DATA_PATH=data/inbox

# ── PII log pseudonymization (required; any long random string) ────
# python -c "import secrets; print(secrets.token_hex(32))"
PII_HMAC_SECRET=change-me

# ── Optional runtime settings (defaults shown) ─────────────────────
# OUTBOX_PATH=data/outbox
# CHECKPOINT_DB=data/checkpoints.sqlite
# LOG_TO_STDOUT=false
# If set, every /api request must send header X-API-Key: <value>.
# APP_API_KEY=
